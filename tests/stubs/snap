#!/bin/bash
echo "snap $*" >>"${STUB_CALL_LOG:-/dev/null}"

if [[ "$1" == "list" ]]; then
    local_name="${2:-}"
    if [[ -n "$local_name" && " ${SNAP_LIST:-} " == *" $local_name "* ]]; then
        printf '%s  1.0  amd64  latest/stable  canonical**\n' "$local_name"
        exit 0
    fi
    exit 0
fi

if [[ "$1" == "install" ]]; then
    fail_times="${SNAP_INSTALL_FAIL_TIMES:-0}"
    count_file="${SANDBOX:-/tmp}/snap-install-count"
    count=0
    if [[ -f "$count_file" ]]; then
        count="$(cat "$count_file")"
    fi
    count=$((count + 1))
    printf '%s\n' "$count" >"$count_file"

    if [[ -n "${SNAP_INSTALL_RC:-}" ]]; then
        exit "${SNAP_INSTALL_RC}"
    fi
    if [[ "$count" -le "$fail_times" ]]; then
        echo "snap stub: failing install attempt $count" >&2
        exit 1
    fi
    exit 0
fi

exit 0
